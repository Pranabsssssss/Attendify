# Required: MongoDB connection string for your own database.
MONGODB_URI=mongodb://127.0.0.1:27017/attendify

# Required: generate a unique random value of at least 32 characters.
# Keep this value private. Use the same value as the RFID firmware API key.
ATTENDANCE_SECURE_KEY=replace-with-a-random-secret-at-least-32-characters

# School configuration
LATE_TIME=08:00:00
NEXT_PUBLIC_LEAVE_CUTOFF_TIME=08:00
NEXT_PUBLIC_ATTENDANCE_START_DATE=2026-06-01
NEXT_PUBLIC_CLASS_RANGE_START=6
NEXT_PUBLIC_CLASS_RANGE_END=12
NEXT_PUBLIC_RESTRICTED_SECTIONS=

# Enrollment codes. NEXT_PUBLIC values are visible in browser code and are not secrets.
NEXT_PUBLIC_ACCESS_CODE_STUDENT=change-this-student-code
NEXT_PUBLIC_ACCESS_CODE_TEACHER=change-this-teacher-code
NEXT_PUBLIC_ACCESS_CODE_PRINCIPAL=change-this-principal-code
NEXT_PUBLIC_ACCESS_CODE_IT_ADMIN=change-this-admin-code

# Optional SMTP settings (required for email OTP password changes)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=Attendify <no-reply@example.com>

# Optional Web Push settings (generate with: npx web-push generate-vapid-keys)
VAPID_SUBJECT=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
